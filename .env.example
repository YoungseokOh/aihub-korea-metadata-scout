AIHUB_API_KEY=
AIHUB_SHELL_PATH=
AIHUB_OUTPUT_DIR=./data
AIHUB_CACHE_DIR=./data/raw

# LLM ideation (ideate / ideate-rank). Provider: lmstudio | openai | anthropic.
AIHUB_LLM_PROVIDER=lmstudio
# LM Studio default; for OpenAI leave blank, for a custom endpoint set the base URL.
AIHUB_LLM_BASE_URL=http://localhost:1234/v1
# Model id. LM Studio: the loaded model name. OpenAI: e.g. gpt-4o-mini. Anthropic: claude-opus-4-8.
AIHUB_LLM_MODEL=
# API key for openai/anthropic providers. LM Studio ignores it.
AIHUB_LLM_API_KEY=
